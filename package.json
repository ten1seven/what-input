{
  "name": "what-input",
  "version": "6.0.1",
  "description": "A global utility for tracking the current input method (mouse, keyboard or touch).",
  "main": "dist/what-input.js",
  "module": "dist/what-input.mjs",
  "types": "dist/what-input.d.ts",
  "unpkg": "dist/what-input.min.js",
  "jsdelivr": "dist/what-input.min.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/what-input.d.mts",
        "default": "./dist/what-input.mjs"
      },
      "require": {
        "types": "./dist/what-input.d.ts",
        "default": "./dist/what-input.js"
      },
      "default": "./dist/what-input.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": true,
  "repository": {
    "url": "https://github.com/ten1seven/what-input.git",
    "type": "git"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "input",
    "focus-visible",
    "pointer-events",
    "javascript",
    "typescript"
  ],
  "author": "Jeremy Fields <jeremy.fields@viget.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ten1seven/what-input/issues"
  },
  "homepage": "https://github.com/ten1seven/what-input",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib && npm run build:demo",
    "build:lib": "node scripts/build.mjs",
    "build:demo": "vite build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "lint": "prettier --check . && tsc --noEmit",
    "pretest": "npm run build:lib",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run lint && npm test",
    "deploy": "npm run build && gh-pages -d build"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "acorn": "^8.19.0",
    "esbuild": "^0.28.2",
    "gh-pages": "^6.3.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.11"
  }
}
